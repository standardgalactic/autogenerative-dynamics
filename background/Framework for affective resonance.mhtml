     </span><span><span class="hljs-keyword">\tfrac</span></span><span>{1}{2}(</span><span><span class="hljs-keyword">\nabla</span></span><span><span class="hljs-keyword">\Phi</span></span><span>)</span><span><span class="hljs-built_in">^</span></span><span>2
    +</span><span><span class="hljs-keyword">\tfrac</span></span><span>{</span><span><span class="hljs-keyword">\lambda</span></span><span>}{2}(</span><span><span class="hljs-keyword">\nabla</span></span><span><span class="hljs-keyword">\!</span></span><span><span class="hljs-keyword">\cdot</span></span><span><span class="hljs-keyword">\!</span></span><span><span class="hljs-keyword">\mathbf</span></span><span>{v})</span><span><span class="hljs-built_in">^</span></span><span>2
    +</span><span><span class="hljs-keyword">\tfrac</span></span><span>{1}{2}D</span><span><span class="hljs-built_in">_</span></span><span>S(</span><span><span class="hljs-keyword">\nabla</span></span><span> S)</span><span><span class="hljs-built_in">^</span></span><span>2
    -</span><span><span class="hljs-keyword">\gamma</span></span><span><span class="hljs-keyword">\,</span></span><span><span class="hljs-keyword">\Phi</span></span><span><span class="hljs-keyword">\,</span></span><span><span class="hljs-keyword">\dot</span></span><span> S
