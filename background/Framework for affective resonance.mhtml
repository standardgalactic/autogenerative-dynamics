</span><span><span class="hljs-keyword">\Phi</span></span><span><span class="hljs-built_in">^</span></span><span>{n+1} </span><span><span class="hljs-built_in">&amp;</span></span><span>= </span><span><span class="hljs-keyword">\Phi</span></span><span><span class="hljs-built_in">^</span></span><span>{n}
 +</span><span><span class="hljs-keyword">\tfrac</span></span><span>{</span><span><span class="hljs-keyword">\Delta</span></span><span> t}{2}</span><span><span class="hljs-keyword">\big</span></span><span>(
