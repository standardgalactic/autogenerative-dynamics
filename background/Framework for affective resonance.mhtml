S'=S/S</span><span><span class="hljs-built_in">_</span></span><span>0,</span><span><span class="hljs-keyword">\quad</span></span><span>
t' = t/</span><span><span class="hljs-keyword">\tau</span></span><span><span class="hljs-built_in">_</span></span><span>0,
