E</span><span><span class="hljs-built_in">_</span></span><span>{</span><span><span class="hljs-keyword">\mathrm</span></span><span>{tot}}
 = </span><span><span class="hljs-keyword">\!</span></span><span><span class="hljs-keyword">\int</span></span><span><span class="hljs-keyword">\!</span></span><span>
