</span><span><span class="hljs-keyword">\partial</span></span><span><span class="hljs-built_in">_</span></span><span>{t'}</span><span><span class="hljs-keyword">\mathbf</span></span><span>{v}' </span><span><span class="hljs-built_in">&amp;</span></span><span>= -</span><span><span class="hljs-keyword">\Lambda</span></span><span><span class="hljs-keyword">\,</span></span><span><span class="hljs-keyword">\nabla</span></span><span>'(</span><span><span class="hljs-keyword">\nabla</span></span><span>'</span><span><span class="hljs-keyword">\!</span></span><span><span class="hljs-keyword">\cdot</span></span><span><span class="hljs-keyword">\!</span></span><span><span class="hljs-keyword">\mathbf</span></span><span>{v}')
