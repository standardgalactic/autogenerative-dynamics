<span class="line"><span style="color: rgb(230, 230, 230);">&nbsp;</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\begin</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">lstlisting</span><span style="color: rgb(230, 230, 230);">}[language=Coq]</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">(* Polyglot Sheaf in Coq *)</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Require Import Coq.Sets.Ensembles.</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Require Import Coq.Logic.FunctionalExtensionality.</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">&nbsp;</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">(* Repository poset *)</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Record Repo : Type := {</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">  files : Ensemble string;</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">  deps : string -&gt; Ensemble string;</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">  deps_acyclic : (* well-founded relation *)</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">}.</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">&nbsp;</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">(* Presheaf *)</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Definition Presheaf := Repo -&gt; Type.</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">&nbsp;</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">(* Restriction maps *)</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Class HasRestriction (F : Presheaf) := {</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">  restrict : forall (U V : Repo),</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">    (files V âŠ† files U) -&gt; F U -&gt; F V;</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">  restrict_id : forall U x, restrict U U _ x = x;</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">  restrict_comp : forall U V W f g x,</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">    restrict V W g (restrict U V f x) = restrict U W _ x</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">}.</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">&nbsp;</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">(* Sheaf condition *)</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Definition is_sheaf (F : Presheaf) `{HasRestriction F} :=</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">  forall (U : Repo) (cover : list Repo),</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">    (Union (map files cover) = files U) -&gt;</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">    forall (sections : forall V, In V cover -&gt; F V),</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">      (forall V W, In V cover -&gt; In W cover -&gt;</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">        restrict _ _ _ (sections V _) =</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">        restrict _ _ _ (sections W _)) -&gt;</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">      exists! (s : F U), forall V,</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">        restrict U V _ s = sections V _.</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">&nbsp;</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Theorem ci_enforces_sheaf :</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">  forall F, verification_passes F -&gt; is_sheaf F.</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Proof.</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">  (* Proof omitted - would require linking formalization *)</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Admitted.</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\end</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">lstlisting</span><span style="color: rgb(230, 230, 230);">}</span></span></code></pre></div><div></div><div class="false flex flex-col gap-2 h-full"></div></div></div>
