<span class="line"><span style="color: rgb(230, 230, 230);">&nbsp;</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\subsection</span><span style="color: rgb(230, 230, 230);">{Case Study 1: Linux Kernel as Polyglot Sheaf}</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">&nbsp;</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\subsubsection</span><span style="color: rgb(230, 230, 230);">{Repository Structure}</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">The Linux kernel consists of:</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\begin</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">itemize</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">\item</span><span style="color: rgb(230, 230, 230);"> Core kernel (C, inline assembly),</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">\item</span><span style="color: rgb(230, 230, 230);"> Device drivers (C, device-tree),</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">\item</span><span style="color: rgb(230, 230, 230);"> Build system (Kbuild, Makefiles),</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">\item</span><span style="color: rgb(230, 230, 230);"> Boot loaders (assembly).</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\end</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">itemize</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">&nbsp;</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\subsubsection</span><span style="color: rgb(230, 230, 230);">{Covering Structure}</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Define cover </span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(78, 201, 176);">\mathcal{U} = \{\texttt{kernel/}, \texttt{drivers/}, \texttt{arch/}\}</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);">.</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Intersections:</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\begin</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">itemize</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">\item</span><span style="color: rgb(78, 201, 176);"> $</span><span style="color: rgb(78, 201, 176);">\texttt{kernel} </span><span style="color: rgb(86, 156, 214);">\cap</span><span style="color: rgb(78, 201, 176);"> \texttt{drivers}</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);"> = headers in </span><span style="color: rgb(220, 220, 170);">\texttt</span><span style="color: rgb(230, 230, 230);">{include/},</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">\item</span><span style="color: rgb(78, 201, 176);"> $</span><span style="color: rgb(78, 201, 176);">\texttt{drivers} </span><span style="color: rgb(86, 156, 214);">\cap</span><span style="color: rgb(78, 201, 176);"> \texttt{arch}</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);"> = platform-specific drivers,</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">\item</span><span style="color: rgb(78, 201, 176);"> $</span><span style="color: rgb(78, 201, 176);">\texttt{arch} </span><span style="color: rgb(86, 156, 214);">\cap</span><span style="color: rgb(78, 201, 176);"> \texttt{kernel}</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);"> = syscall ABI definitions.</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\end</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">itemize</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">&nbsp;</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\subsubsection</span><span style="color: rgb(230, 230, 230);">{Sheaf Data}</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">For each </span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(78, 201, 176);">U </span><span style="color: rgb(86, 156, 214);">\in</span><span style="color: rgb(78, 201, 176);"> \mathcal{U}</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);">:</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\[</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\mathcal{F}(U) = </span><span style="color: rgb(220, 220, 170);">\begin</span><span style="color: rgb(78, 201, 176);">{</span><span style="color: rgb(156, 220, 254);">cases</span><span style="color: rgb(78, 201, 176);">}</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">(\text{C}, \text{\texttt{*.c} files}, \text{ELF}, </span><span style="color: rgb(86, 156, 214);">\partial</span><span style="color: rgb(78, 201, 176);"> = \text{exports})</span></span>
<span class="line"><span style="color: rgb(197, 134, 192);">&amp;</span><span style="color: rgb(78, 201, 176);"> U = \texttt{kernel}, </span><span style="color: rgb(197, 134, 192);">\\</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">(\text{C+DT}, \text{\texttt{*.c+*.dts}}, \text{KO}, </span><span style="color: rgb(86, 156, 214);">\partial</span><span style="color: rgb(78, 201, 176);"> = \text{module</span><span style="color: rgb(215, 186, 125);">\_</span><span style="color: rgb(78, 201, 176);">init})</span></span>
<span class="line"><span style="color: rgb(197, 134, 192);">&amp;</span><span style="color: rgb(78, 201, 176);"> U = \texttt{drivers}, </span><span style="color: rgb(197, 134, 192);">\\</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">(\text{ASM+C}, \text{\texttt{*.S}}, \text{bootable}, </span><span style="color: rgb(86, 156, 214);">\partial</span><span style="color: rgb(78, 201, 176);"> = \text{entry})</span></span>
<span class="line"><span style="color: rgb(197, 134, 192);">&amp;</span><span style="color: rgb(78, 201, 176);"> U = \texttt{arch}.</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\end</span><span style="color: rgb(78, 201, 176);">{</span><span style="color: rgb(156, 220, 254);">cases</span><span style="color: rgb(78, 201, 176);">}</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\]</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">&nbsp;</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\subsubsection</span><span style="color: rgb(230, 230, 230);">{Gluing Verification}</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">The kernel build system enforces sheaf conditions:</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\begin</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">enumerate</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">\item</span><span style="color: rgb(220, 220, 170);"> \textit</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(230, 230, 230); font-style: italic;">Symbol resolution:</span><span style="color: rgb(230, 230, 230);">} </span><span style="color: rgb(220, 220, 170);">\texttt</span><span style="color: rgb(230, 230, 230);">{System.map} checks that exported</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">symbols in intersections match,</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">\item</span><span style="color: rgb(220, 220, 170);"> \textit</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(230, 230, 230); font-style: italic;">Type compatibility:</span><span style="color: rgb(230, 230, 230);">} Header guards prevent redefinitions,</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">\item</span><span style="color: rgb(220, 220, 170);"> \textit</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(230, 230, 230); font-style: italic;">Link-time validation:</span><span style="color: rgb(230, 230, 230);">} </span><span style="color: rgb(220, 220, 170);">\texttt</span><span style="color: rgb(230, 230, 230);">{ld} fails on undefined references.</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\end</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">enumerate</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">&nbsp;</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\begin</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">proposition</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">The Linux kernel satisfies the polyglot sheaf condition under the cover</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(78, 201, 176);">\mathcal{U}</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);">.</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\end</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">proposition</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">&nbsp;</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\begin</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">proof</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">CI system (kernel.org build bots) runs:</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\begin</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">lstlisting</span><span style="color: rgb(230, 230, 230);">}[language=bash]</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">make defconfig</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">make -j$(nproc)</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">make modules</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">make modules_install</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\end</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">lstlisting</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Success implies:</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\begin</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">itemize</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">\item</span><span style="color: rgb(230, 230, 230);"> Equalizer diagram holds (all symbols resolve),</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">\item</span><span style="color: rgb(230, 230, 230);"> Global section exists (</span><span style="color: rgb(220, 220, 170);">\texttt</span><span style="color: rgb(230, 230, 230);">{vmlinuz} boots),</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">\item</span><span style="color: rgb(230, 230, 230);"> Unique up to build configuration (deterministic linking).</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\end</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">itemize</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\end</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">proof</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">&nbsp;</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\subsubsection</span><span style="color: rgb(230, 230, 230);">{Cohomology Computation}</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">The ÄŒech complex:</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\[</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">C^</span><span style="color: rgb(181, 206, 168);">0</span><span style="color: rgb(78, 201, 176);"> = \mathcal{F}(\texttt{kernel}) </span><span style="color: rgb(86, 156, 214);">\times</span><span style="color: rgb(78, 201, 176);"> \mathcal{F}(\texttt{drivers})</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">\times</span><span style="color: rgb(78, 201, 176);"> \mathcal{F}(\texttt{arch}),</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\]</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\[</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">C^</span><span style="color: rgb(181, 206, 168);">1</span><span style="color: rgb(78, 201, 176);"> = \mathcal{F}(\texttt{include/}) </span><span style="color: rgb(86, 156, 214);">\times</span><span style="color: rgb(86, 156, 214);"> \cdots</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\]</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">has </span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(78, 201, 176);">\check{H}^</span><span style="color: rgb(181, 206, 168);">1</span><span style="color: rgb(78, 201, 176);"> = </span><span style="color: rgb(181, 206, 168);">0</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);"> because headers provide acyclic interface resolution.</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">&nbsp;</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\paragraph</span><span style="color: rgb(230, 230, 230);">{Failure Mode:} If driver </span><span style="color: rgb(220, 220, 170);">\texttt</span><span style="color: rgb(230, 230, 230);">{foo.ko} and kernel both define</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\texttt</span><span style="color: rgb(230, 230, 230);">{bar</span><span style="color: rgb(215, 186, 125);">\_</span><span style="color: rgb(230, 230, 230);">func}, </span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(78, 201, 176);">\check{H}^</span><span style="color: rgb(181, 206, 168);">1</span><span style="color: rgb(86, 156, 214);"> \neq</span><span style="color: rgb(181, 206, 168);"> 0</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);">, detected as link error.</span></span></code></pre></div><div></div><div class="false flex flex-col gap-2 h-full"></div></div></div>
