<span class="line"><span style="color: rgb(106, 153, 85);">%  PART II â€“ RSVP Translation</span></span>
<span class="line"><span style="color: rgb(106, 153, 85);">%  From Autogenerative Manifolds to the Scalarâ€“Vectorâ€“Entropy Triad</span></span>
<span class="line"><span style="color: rgb(106, 153, 85);">%======================================================================</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\part</span><span style="color: rgb(230, 230, 230);">{RSVP Field Translation</span><span style="color: rgb(197, 134, 192);">\\</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\vspace</span><span style="color: rgb(230, 230, 230);">{1ex}</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\small</span><span style="color: rgb(230, 230, 230);"> Scalarâ€“Vectorâ€“Entropy Triad </span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(220, 220, 170);">\;</span><span style="color: rgb(86, 156, 214);">\leftrightarrow</span><span style="color: rgb(220, 220, 170);">\;</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);"> Statistical Manifold}</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\begin</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">abstract</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">We prove a rigorous equivalence between the non-Markovian statistical manifold of Part I and the RSVP triad </span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(78, 201, 176);">(</span><span style="color: rgb(86, 156, 214);">\Phi</span><span style="color: rgb(78, 201, 176);">,\mathbf{v},S)</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);">.  </span></span>
