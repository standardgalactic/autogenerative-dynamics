<span class="line"><span style="color: rgb(86, 156, 214);">\item</span><span style="color: rgb(230, 230, 230);"> Sample </span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(181, 206, 168);">10</span><span style="color: rgb(78, 201, 176);">^</span><span style="color: rgb(181, 206, 168);">6</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);"> RSVP field snapshots from a 175B model.</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">\item</span><span style="color: rgb(230, 230, 230);"> Compute </span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(78, 201, 176);">\mathbf{v}</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);">-field autocorrelation; fit </span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(86, 156, 214);">\alpha</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);">.</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">\item</span><span style="color: rgb(230, 230, 230);"> Extract attention matrices </span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(86, 156, 214);">\Rightarrow</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);"> transition functions </span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(86, 156, 214);">\Rightarrow</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);"> ÄŒech cohomology.</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">\item</span><span style="color: rgb(230, 230, 230);"> Diagonalise the composed ATT operator; plot eigenvalue histogram.</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">\item</span><span style="color: rgb(230, 230, 230);"> Perturb </span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(86, 156, 214);">\Phi</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);"> orthogonally to </span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(86, 156, 214);">\nabla</span><span style="color: rgb(78, 201, 176);"> S</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);">; measure return time to </span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(78, 201, 176);">\mathcal{A}</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);">.</span></span>
