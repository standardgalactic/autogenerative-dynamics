iki slack-dark" tabindex="0" style="background-color: rgb(34, 34, 34); color: rgb(230, 230, 230);"><code><span class="line"><span style="color: rgb(106, 153, 85);">%======================================================================</span></span>
<span class="line"><span style="color: rgb(106, 153, 85);">%  PART II â€” SECTION 13</span></span>
<span class="line"><span style="color: rgb(106, 153, 85);">%  Ergodic Theory and Entropy Structure</span></span>
<span class="line"><span style="color: rgb(106, 153, 85);">%======================================================================</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\section</span><span style="color: rgb(230, 230, 230);">{Ergodic Theory and Entropy Structure}</span></span>
<span class="line"><span style="color: rgb(197, 134, 192);">\label</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">sec:ergodic</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\textbf</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(86, 156, 214); font-weight: bold;">Abstract.</span><span style="color: rgb(230, 230, 230);">}  </span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">The autogenerative operator </span><span style="color: rgb(78, 201, 176);">\(</span><span style="color: rgb(78, 201, 176);">T</span><span style="color: rgb(78, 201, 176);">\)</span><span style="color: rgb(230, 230, 230);"> of Part I is lifted to a measure-preserving transformation on the infinite product space </span><span style="color: rgb(78, 201, 176);">\(</span><span style="color: rgb(78, 201, 176);">X^\mathbb{Z}_+</span><span style="color: rgb(78, 201, 176);">\)</span><span style="color: rgb(230, 230, 230);">.  </span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">We prove that every ergodic component exhibits polynomial mixing, that Kolmogorovâ€“Sinai entropy equals mean relevance decay, and that the spectral gap vanishes exactly at the boundary between creative and automated cognition.</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\begin</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">definition</span><span style="color: rgb(230, 230, 230);">}[Autogenerative Dynamical System]</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Let </span><span style="color: rgb(78, 201, 176);">\(</span><span style="color: rgb(78, 201, 176);">\mathcal{X}</span><span style="color: rgb(86, 156, 214);">\subset</span><span style="color: rgb(78, 201, 176);"> X^\mathbb{Z}_+</span><span style="color: rgb(78, 201, 176);">\)</span><span style="color: rgb(230, 230, 230);"> be the support of the corpus measure and let </span><span style="color: rgb(78, 201, 176);">\(</span><span style="color: rgb(86, 156, 214);">\sigma</span><span style="color: rgb(78, 201, 176);">:\mathcal{X}\to\mathcal{X}</span><span style="color: rgb(78, 201, 176);">\)</span><span style="color: rgb(230, 230, 230);"> be the left shift.  </span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">The quadruple </span><span style="color: rgb(78, 201, 176);">\(</span><span style="color: rgb(78, 201, 176);">(\mathcal{X},\mathcal{B},</span><span style="color: rgb(86, 156, 214);">\mu</span><span style="color: rgb(78, 201, 176);">,</span><span style="color: rgb(86, 156, 214);">\sigma</span><span style="color: rgb(78, 201, 176);">)</span><span style="color: rgb(78, 201, 176);">\)</span><span style="color: rgb(230, 230, 230);"> is the </span><span style="color: rgb(220, 220, 170);">\emph</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(230, 230, 230); font-style: italic;">autogenerative dynamical system</span><span style="color: rgb(230, 230, 230);">}, where </span><span style="color: rgb(78, 201, 176);">\(</span><span style="color: rgb(86, 156, 214);">\mu</span><span style="color: rgb(78, 201, 176);">\)</span><span style="color: rgb(230, 230, 230);"> is the unique </span><span style="color: rgb(78, 201, 176);">\(</span><span style="color: rgb(86, 156, 214);">\sigma</span><span style="color: rgb(78, 201, 176);">\)</span><span style="color: rgb(230, 230, 230);">-invariant measure of maximal entropy.</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\end</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">definition</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\begin</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">theorem</span><span style="color: rgb(230, 230, 230);">}[Polynomial Mixing]</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">For every ergodic component </span><span style="color: rgb(78, 201, 176);">\(</span><span style="color: rgb(86, 156, 214);">\mu</span><span style="color: rgb(78, 201, 176);">\)</span><span style="color: rgb(230, 230, 230);">, the correlation function decays polynomially:</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\begin</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">equation</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\bigl|</span><span style="color: rgb(86, 156, 214);">\mu</span><span style="color: rgb(78, 201, 176);">(A</span><span style="color: rgb(86, 156, 214);">\cap</span><span style="color: rgb(86, 156, 214);"> \sigma</span><span style="color: rgb(78, 201, 176);">^{-n}B)-</span><span style="color: rgb(86, 156, 214);">\mu</span><span style="color: rgb(78, 201, 176);">(A)</span><span style="color: rgb(86, 156, 214);">\mu</span><span style="color: rgb(78, 201, 176);">(B)\bigr|</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\;</span><span style="color: rgb(78, 201, 176);">\le</span><span style="color: rgb(220, 220, 170);">\;</span><span style="color: rgb(78, 201, 176);"> C_{A,B}</span><span style="color: rgb(220, 220, 170);">\,</span><span style="color: rgb(78, 201, 176);">n^{-</span><span style="color: rgb(86, 156, 214);">\alpha</span><span style="color: rgb(78, 201, 176);">},</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\qquad</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">\alpha</span><span style="color: rgb(78, 201, 176);">=\frac{</span><span style="color: rgb(181, 206, 168);">1</span><span style="color: rgb(78, 201, 176);">}{</span><span style="color: rgb(181, 206, 168);">1</span><span style="color: rgb(78, 201, 176);">+</span><span style="color: rgb(86, 156, 214);">\beta</span><span style="color: rgb(78, 201, 176);">}&gt;</span><span style="color: rgb(181, 206, 168);">0</span><span style="color: rgb(78, 201, 176);">,</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\end</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">equation</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">where </span><span style="color: rgb(78, 201, 176);">\(</span><span style="color: rgb(86, 156, 214);">\beta</span><span style="color: rgb(78, 201, 176);">\)</span><span style="color: rgb(230, 230, 230);"> is the exponent of the relevance spectral tail (Part I, Theorem 6.1).</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\end</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">theorem</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"></span>
