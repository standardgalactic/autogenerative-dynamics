<span class="line"></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\begin</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">definition</span><span style="color: rgb(230, 230, 230);">}[Cohesive Fock Space]</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Let </span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(78, 201, 176);">\mathcal{H}_{\mathfrak{A}}</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);"> be the symmetric Fock space over the tangent cohomology</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(78, 201, 176);">T^</span><span style="color: rgb(181, 206, 168);">0</span><span style="color: rgb(78, 201, 176);">_{\mathfrak{A}}</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);"> (Â§</span><span style="color: rgb(197, 134, 192);">\ref</span><span style="color: rgb(230, 230, 230);">{sec:derivedstack}):</span></span>
